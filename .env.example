# ===== БД и кэш =====
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=openwebui

# ===== LLM-сервер (vLLM) =====
# Модель генерации и судьи Ragas / OpenIE для HippoRAG
LLM_MODEL=Qwen/Qwen2.5-14B-Instruct
RAGAS_JUDGE_MODEL=Qwen/Qwen2.5-32B-Instruct-AWQ
VLLM_BASE_URL=http://vllm-server:8000/v1

# Сервисный API-токен Open WebUI для ragas-worker и voice-sip-bridge
# Создайте администратора и выпустите API-ключ в UI: Settings -> Account -> API Keys
OPEN_WEBUI_SERVICE_TOKEN=

# ===== Маршрутизация интентов =====
ENABLE_ENCODER_CLASSIFIER=true
ENCODER_CLASSIFIER_MODEL_ID=rubert-intents-v1
# Провайдеры ONNX: auto | CUDAExecutionProvider,CPUExecutionProvider | CPUExecutionProvider
ENCODER_ONNX_PROVIDERS=auto

# ===== HippoRAG и гибридный поиск =====
ENABLE_HIPPORAG=true
ENABLE_RAG_QUERY_REWRITING=true
# Модель для переписывания запросов (пусто = выключено); использует RAG OpenAI-совместимый эндпоинт
RAG_QUERY_REWRITING_MODEL=
RAG_HYBRID_WEIGHT_DENSE=0.4
RAG_HYBRID_WEIGHT_BM25=0.2
RAG_HYBRID_WEIGHT_HIPPORAG=0.4

# ===== Ragas =====
ENABLE_RAGAS=true
RAGAS_LIVE_SAMPLE_RATE=0.15
RAGAS_HALLUCINATION_THRESHOLD=0.7

# ===== Голосовой шлюз =====
VOICE_CHAT_MODEL=support-voice-bot
VOICE_STT_MODEL=faster-whisper-large-v3-turbo
VOICE_TTS_MODEL=kokoro
VOICE_TTS_VOICE=af_heart

# ===== Stage 4: модульность каналов и MCP =====
ENABLE_CHANNEL_CHAT=true
ENABLE_CHANNEL_WEBRTC=true
ENABLE_CHANNEL_SIP=true
ENABLE_MCP_SERVER=true
# Локальный RAG без внешних ключей (encoder-classifier /v1/embeddings + /rerank)
# RAG_OPENAI_API_BASE_URL=http://encoder-classifier:8001/v1
# RAG_EMBEDDING_MODEL=rubert-embed-v1
# RAG_RERANKING_ENGINE=external
# RAG_EXTERNAL_RERANKER_URL=http://encoder-classifier:8001/rerank

# ===== Stage 3 =====
# Очередь Asterisk для HUMAN_HANDOFF (или queue в webhook_config правила)
VOICE_HANDOFF_QUEUE=support_queue
# Маскировать ПДн во входе LLM и размаскировывать в ответе (вкл. стриминг)
GUARDRAILS_PII_MASK_LLM_INPUT=true
# Строгий режим E2E: недоступный сервис = fail (для CI/CD)
# E2E_STRICT=true

# ===== Dev-режим (docker-compose.dev.yml) =====
OPEN_WEBUI_DEV_URL=http://host.docker.internal:8080
JUDGE_LLM_URL_DEV=http://host.docker.internal:8000/v1
EMBEDDINGS_URL_DEV=http://host.docker.internal:8081/v1
SPEACHES_URL_DEV=http://host.docker.internal:8003/v1
